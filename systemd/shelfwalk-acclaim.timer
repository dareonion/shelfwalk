[Unit]
Description=shelfwalk — weekly awards refresh

[Timer]
# Sunday 04:00. The awards are annual and their pages are read from the mirror
# once fetched, so a new winner on an already-mirrored page is not picked up
# (docs/sources.md); chart sources re-fetch every run.
OnCalendar=Sun *-*-* 04:00:00
Persistent=true
RandomizedDelaySec=30min

[Install]
WantedBy=timers.target
