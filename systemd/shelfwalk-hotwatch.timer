[Unit]
Description=shelfwalk — four-hourly hot-release check

[Timer]
# Every four hours: a release's queue moves by the hour around publication,
# and the poll is cheap.
OnCalendar=*-*-* 00/4:15:00
# if the machine was asleep, run once it comes back
Persistent=true
RandomizedDelaySec=10min

[Install]
WantedBy=timers.target
