[Unit]
Description=shelfwalk — refresh Bay Area library availability
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=%h/gitrepo/shelfwalk/refresh.sh
# a full pass is ~30 min, but LINK+ throttles under repeated runs
# and back-off can stretch it; kill only a genuinely stuck run
TimeoutStartSec=90min
Environment="SHELFWALK_PUSH=1"
# git push needs the SSH key; a user service has no agent, so point ssh at the
# key directly (BatchMode so a passphrase-protected key fails loudly in the
# log instead of hanging until the start timeout)
Environment="GIT_SSH_COMMAND=ssh -i %h/.ssh/id_ed25519 -o BatchMode=yes"
